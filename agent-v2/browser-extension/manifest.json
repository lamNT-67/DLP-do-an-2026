{
  "manifest_version": 3,
  "name": "DLP Lab Upload Guard",
  "version": "0.1.0",
  "description": "Lab prototype: checks file-picker uploads against local DLP Agent policy.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "DLP Upload Guard"
  }
}
